# ==============================================================================
# OpenStream API — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# Application Metadata
PROJECT_NAME="OpenStream API"
VERSION="0.1.0"
ENVIRONMENT="development" # development | staging | production
DEBUG=true

# Server Network Configuration
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/openstream"

# Security & Authentication (JWT)
# Generate a strong 256-bit secret key in terminal: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
# JSON array of origins or comma-separated list of allowed frontend origins
ALLOWED_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# ==============================================================================
# Pinata / IPFS Configuration (Phase 7)
# ==============================================================================
# Obtain Pinata credentials from https://app.pinata.cloud/developers/api-keys
# Server-side uploads use the JWT if provided, or API Key & Secret as fallback.
PINATA_API_KEY="your-pinata-api-key"
PINATA_API_SECRET="your-pinata-api-secret"
PINATA_JWT="your-pinata-jwt-token"

# IPFS Gateway URL for video playback (e.g., https://gateway.pinata.cloud/ipfs or your dedicated gateway)
PINATA_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"

# Maximum upload size in bytes (e.g., 524288000 = 500 MB)
MAX_UPLOAD_SIZE_BYTES=524288000

# ==============================================================================
# Blockchain Settlement (Future Phase)
# ==============================================================================
